# Deevee Capital — Environment Configuration
# Copy this file to .env.local and fill in values before deploying to production.

# Site URL (used for Open Graph & canonical metadata)
NEXT_PUBLIC_SITE_URL="https://deeveecapital.com"

# ==============================================================================
# EMAIL DELIVERY CONFIGURATION (Pitch notifications to siddharth & ravi)
# ==============================================================================
# Option 1: Google Workspace / Gmail SMTP for @deeveecapital.com (RECOMMENDED)
# Generate a Google App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="siddharth@deeveecapital.com"
SMTP_PASSWORD="your-16-char-google-app-password"
SMTP_FROM="Deevee Capital <siddharth@deeveecapital.com>"

# Option 2: Resend (Alternative high-deliverability transactional email)
# Create an API key at https://resend.com
RESEND_API_KEY=""
RESEND_FROM="Deevee Capital <pitches@deeveecapital.com>"

# ==============================================================================
# SUBMISSION PERSISTENCE & GOOGLE SHEETS
# ==============================================================================
# Admin Secret Token (required to read submissions via GET /api/pitch with header x-admin-key)
# Generate with: openssl rand -hex 32
ADMIN_API_SECRET=""

# Option A: Google Apps Script Web App URL (simplest Google Sheets row append)
GOOGLE_SHEETS_WEBHOOK_URL=""

# Option B: Direct Google Sheets API v4 via Service Account
GOOGLE_SHEETS_SPREADSHEET_ID=""
GOOGLE_SHEETS_RANGE="Submissions!A:M"
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""

# Optional: Notification Webhook (Slack / Discord channel alert on new pitch)
PITCH_NOTIFICATION_WEBHOOK_URL=""
