{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "bucket": "deeveecapital-site-vault",
    "rules": "storage.rules"
  },
  "hosting": {
    "site": "deeveecapital-site",
    "source": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "data/**",
      "public/uploads/**"
    ],
    "cleanUrls": true,
    "frameworksBackend": {
      "region": "us-central1",
      "memory": "1GiB",
      "maxInstances": 10
    }
  }
}
