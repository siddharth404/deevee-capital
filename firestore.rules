          'fileName', 'fileType', 'mimeType', 'fileSize', 'storagePath',
          'downloadUrl', 'externalUrl', 'category', 'confidentiality',
          'allowedUserIds', 'allowedRoles', 'version', 'previousVersionId',
          'description', 'tags', 'uploadedBy', 'uploadedByName',
          'createdAt', 'updatedAt'
        ]) &&
        validStringLength('title', 1, 300) &&
        validStringLength('category', 1, 100) &&
        (data.confidentiality in ['public_internal', 'standard', 'internal', 'restricted', 'confidential']) &&
        validStringLength('uploadedBy', 1, 128) &&
        isValidTimeField('createdAt') &&
        isValidOptionalString('id', 1, 128) &&
        isValidOptionalString('startupId', 0, 128) &&
        isValidOptionalString('startupName', 0, 200) &&
        isValidOptionalString('submissionId', 0, 128) &&
        isValidOptionalString('researchId', 0, 128) &&
        isValidOptionalString('fileName', 0, 300) &&
        isValidOptionalString('fileType', 0, 80) &&
        isValidOptionalString('mimeType', 0, 120) &&
        isValidOptionalNumber('fileSize', 0, 104857600) &&
        isValidOptionalString('storagePath', 0, 1024) &&
        isValidOptionalString('downloadUrl', 0, 2048) &&
        isValidOptionalUrl('externalUrl') &&
        isValidOptionalList('allowedUserIds', 200) &&
        isValidOptionalList('allowedRoles', 20) &&
        isValidOptionalNumber('version', 1, 1000) &&
        isValidOptionalString('previousVersionId', 0, 128) &&
        isValidOptionalString('description', 0, 5000) &&
        isValidOptionalList('tags', 50) &&
        isValidOptionalString('uploadedByName', 0, 120) &&
        isValidOptionalTimeField('updatedAt');
    }

    function isValidResearchLibraryItem(data) {
      return hasRequiredFields(['title', 'category', 'authorId', 'createdAt']) &&
        hasOnlyAllowedFields([
          'id', 'title', 'summary', 'notes', 'category', 'sector', 'tags',
          'content', 'sourceUrl', 'sourceUrls', 'attachmentUrl', 'attachments',
          'startupIds', 'relatedStartupIds', 'relatedStartupNames', 'authorId',
          'authorName', 'contributorIds', 'contributorNames', 'status',
          'confidentiality', 'allowedUserIds', 'isFeatured', 'viewCount',
          'createdAt', 'updatedAt'
        ]) &&
        validStringLength('title', 1, 300) &&
        validStringLength('category', 1, 120) &&
        validStringLength('authorId', 1, 128) &&
        isValidTimeField('createdAt') &&
        isValidOptionalString('id', 1, 128) &&
        isValidOptionalString('summary', 0, 5000) &&
        isValidOptionalString('notes', 0, 50000) &&
        isValidOptionalString('sector', 0, 160) &&
        isValidOptionalList('tags', 100) &&
        isValidOptionalString('content', 0, 50000) &&
        isValidOptionalUrl('sourceUrl') &&
        isValidOptionalList('sourceUrls', 100) &&
        isValidOptionalUrl('attachmentUrl') &&
        isValidOptionalList('attachments', 50) &&
        isValidOptionalList('startupIds', 100) &&
        isValidOptionalList('relatedStartupIds', 100) &&
        isValidOptionalList('relatedStartupNames', 100) &&
        isValidOptionalString('authorName', 0, 120) &&
        isValidOptionalList('contributorIds', 100) &&
        isValidOptionalList('contributorNames', 100) &&
        isValidOptionalString('status', 0, 60) &&
        (!('confidentiality' in data) || data.confidentiality == null || (data.confidentiality in ['public_internal', 'standard', 'internal', 'restricted', 'confidential'])) &&
        isValidOptionalList('allowedUserIds', 200) &&
        isValidOptionalBool('isFeatured') &&
        isValidOptionalNumber('viewCount', 0, 10000000) &&
        isValidOptionalTimeField('updatedAt');
    }

    function isValidPipelineStage(data) {
      return hasRequiredFields(['name', 'order', 'createdAt']) &&
        hasOnlyAllowedFields([
          'id', 'name', 'slug', 'description', 'order', 'color', 'isDefault',
          'isTerminal', 'requiredFields', 'allowedRoles', 'status',
          'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        validStringLength('name', 1, 120) &&
        data.order is number && data.order >= 0 && data.order <= 1000 &&
        isValidTimeField('createdAt') &&
        isValidOptionalString('id', 1, 128) &&
        isValidOptionalString('slug', 0, 120) &&
        isValidOptionalString('description', 0, 1000) &&
        isValidOptionalString('color', 0, 40) &&
        isValidOptionalBool('isDefault') &&
        isValidOptionalBool('isTerminal') &&
        isValidOptionalList('requiredFields', 50) &&
        isValidOptionalList('allowedRoles', 20) &&
        isValidOptionalString('status', 0, 60) &&
        isValidOptionalString('createdBy', 0, 128) &&
        isValidOptionalTimeField('updatedAt');
    }

    function isValidSavedView(data) {
      return hasRequiredFields(['name', 'filters', 'createdAt']) &&
        hasOnlyAllowedFields([
          'id', 'name', 'description', 'userId', 'ownerId', 'ownerName',
          'isSystem', 'entityType', 'filters', 'sortBy', 'sortOrder',
          'columns', 'groupBy', 'isShared', 'sharedWithRoles', 'isDefault',
          'createdAt', 'updatedAt'
        ]) &&
        validStringLength('name', 1, 160) &&
        data.filters is map && data.filters.size() <= 50 &&
        isValidTimeField('createdAt') &&
        isValidOptionalString('id', 1, 128) &&
        isValidOptionalString('description', 0, 1000) &&
        isValidOptionalString('userId', 0, 128) &&
        isValidOptionalString('ownerId', 0, 128) &&
        isValidOptionalString('ownerName', 0, 120) &&
        isValidOptionalBool('isSystem') &&
        isValidOptionalString('entityType', 0, 80) &&
        isValidOptionalString('sortBy', 0, 80) &&
        isValidOptionalString('sortOrder', 0, 20) &&
        isValidOptionalList('columns', 50) &&
        isValidOptionalString('groupBy', 0, 80) &&
        isValidOptionalBool('isShared') &&
        isValidOptionalList('sharedWithRoles', 20) &&
        isValidOptionalBool('isDefault') &&
        isValidOptionalTimeField('updatedAt');
    }

    function isValidResearchTemplate(data) {
      return hasRequiredFields(['name', 'updatedAt', 'updatedBy']) &&
        hasOnlyAllowedFields([
          'id', 'name', 'description', 'category', 'sector', 'stage',
          'templateType', 'defaultObjectives', 'defaultInstructions',
          'defaultChecklist', 'requiredSections', 'sections', 'prompts',
          'requiredSources', 'isSystem', 'isDefault', 'status', 'version',
          'createdBy', 'updatedBy', 'createdAt', 'updatedAt'
        ]) &&
        validStringLength('name', 1, 200) &&
        isValidTimeField('updatedAt') &&
        validStringLength('updatedBy', 1, 128) &&
        isValidOptionalString('id', 1, 128) &&
        isValidOptionalString('description', 0, 3000) &&
        isValidOptionalString('category', 0, 120) &&
        isValidOptionalString('sector', 0, 160) &&
        isValidOptionalString('stage', 0, 120) &&
        isValidOptionalString('templateType', 0, 80) &&
        isValidOptionalString('defaultObjectives', 0, 5000) &&
        isValidOptionalString('defaultInstructions', 0, 5000) &&
        isValidOptionalList('defaultChecklist', 100) &&
        isValidOptionalList('requiredSections', 50) &&
        isValidOptionalList('sections', 50) &&
        isValidOptionalList('prompts', 50) &&
        isValidOptionalList('requiredSources', 50) &&
        isValidOptionalBool('isSystem') &&
        isValidOptionalBool('isDefault') &&
        isValidOptionalString('status', 0, 60) &&
        isValidOptionalNumber('version', 1, 1000) &&
        isValidOptionalString('createdBy', 0, 128) &&
        isValidOptionalTimeField('createdAt');
    }

    function isValidActivityLog(data) {
      return hasRequiredFields(['actorId', 'action']) &&
        hasOnlyAllowedFields([
          'id', 'actorId', 'actorName', 'actorEmail', 'actorRole', 'action',
          'entityType', 'entityId', 'entityName', 'targetType', 'targetId',
          'targetName', 'startupId', 'summary', 'details', 'previousValue',
          'newValue', 'metadata', 'ipAddress', 'userAgent', 'timestamp', 'createdAt'
        ]) &&
        validStringLength('actorId', 1, 128) &&
        validStringLength('action', 1, 120) &&
        isValidOptionalString('id', 1, 128) &&
        isValidOptionalString('actorName', 0, 120) &&
        (!('actorEmail' in data) || data.actorEmail == null || data.actorEmail == "" || isValidEmail(data.actorEmail)) &&
        isValidOptionalString('actorRole', 0, 80) &&
        isValidOptionalString('entityType', 0, 80) &&
        isValidOptionalString('entityId', 0, 128) &&
        isValidOptionalString('entityName', 0, 250) &&
        isValidOptionalString('targetType', 0, 80) &&
        isValidOptionalString('targetId', 0, 128) &&
        isValidOptionalString('targetName', 0, 250) &&
        isValidOptionalString('startupId', 0, 128) &&
        isValidOptionalString('summary', 0, 2000) &&
        isValidOptionalString('details', 0, 5000) &&
        isValidOptionalString('previousValue', 0, 10000) &&
        isValidOptionalString('newValue', 0, 10000) &&
        isValidOptionalMap('metadata', 50) &&
        isValidOptionalString('ipAddress', 0, 80) &&
        isValidOptionalString('userAgent', 0, 500) &&
        isValidOptionalTimeField('timestamp') &&
        isValidOptionalTimeField('createdAt');
    }

    function isValidAuditLog(data) {
      return hasRequiredFields(['actorId', 'action']) &&
        hasOnlyAllowedFields([
          'id', 'actorId', 'actorName', 'actorEmail', 'actorRole', 'action',
          'severity', 'entityType', 'entityId', 'entityName', 'resourceType',
          'resourceId', 'targetUserId', 'startupId', 'summary', 'previousValue',
          'newValue', 'beforeState', 'afterState', 'metadata', 'ipAddress',
          'userAgent', 'timestamp', 'createdAt'
        ]) &&
        validStringLength('actorId', 1, 128) &&
        validStringLength('action', 1, 120) &&
        isValidOptionalString('id', 1, 128) &&
        isValidOptionalString('actorName', 0, 120) &&
        (!('actorEmail' in data) || data.actorEmail == null || data.actorEmail == "" || isValidEmail(data.actorEmail)) &&
        isValidOptionalString('actorRole', 0, 80) &&
        (!('severity' in data) || data.severity == null || (data.severity in ['info', 'low', 'medium', 'high', 'critical'])) &&
        isValidOptionalString('entityType', 0, 80) &&
        isValidOptionalString('entityId', 0, 128) &&
        isValidOptionalString('entityName', 0, 250) &&
        isValidOptionalString('resourceType', 0, 80) &&
        isValidOptionalString('resourceId', 0, 128) &&
        isValidOptionalString('targetUserId', 0, 128) &&
        isValidOptionalString('startupId', 0, 128) &&
        isValidOptionalString('summary', 0, 2000) &&
        isValidOptionalString('previousValue', 0, 10000) &&
        isValidOptionalString('newValue', 0, 10000) &&
        isValidOptionalMap('beforeState', 100) &&
        isValidOptionalMap('afterState', 100) &&
        isValidOptionalMap('metadata', 50) &&
        isValidOptionalString('ipAddress', 0, 80) &&
        isValidOptionalString('userAgent', 0, 500) &&
        isValidOptionalTimeField('timestamp') &&
        isValidOptionalTimeField('createdAt');
    }

    function isValidWorkspaceSetting(data) {
      return hasRequiredFields(['updatedBy', 'updatedAt']) &&
        hasOnlyAllowedFields([
          'id', 'category', 'workspaceName', 'organizationName', 'domain',
          'investmentCapNote', 'mandateNote', 'defaultInternAccessScope',
          'requireTamCitation', 'requireHumanDecisionConfirmation',
          'customSectors', 'customIndustries', 'roleTemplates',
          'allowedDomains', 'requireMfa', 'sessionTimeoutMinutes',
          'defaultAccessScope', 'defaultRole', 'allowInternStartupCreation',
          'requireTwoStepApproval', 'confidentialityDefaults',
          'notificationSettings', 'branding', 'integrations',
          'securityConfig', 'updatedBy', 'createdAt', 'updatedAt'
        ]) &&
        validStringLength('updatedBy', 1, 128) &&
        isValidTimeField('updatedAt') &&
        isValidOptionalString('id', 1, 128) &&
        isValidOptionalString('category', 0, 80) &&
        isValidOptionalString('workspaceName', 0, 160) &&
        isValidOptionalString('organizationName', 0, 160) &&
        isValidOptionalString('domain', 0, 160) &&
        isValidOptionalString('investmentCapNote', 0, 1000) &&
        isValidOptionalString('mandateNote', 0, 2000) &&
        (!('defaultInternAccessScope' in data) || data.defaultInternAccessScope == null || (data.defaultInternAccessScope in ['all', 'assigned'])) &&
        isValidOptionalBool('requireTamCitation') &&
        isValidOptionalBool('requireHumanDecisionConfirmation') &&
        isValidOptionalList('customSectors', 100) &&
        isValidOptionalList('customIndustries', 100) &&
        isValidOptionalMap('roleTemplates', 20) &&
        isValidOptionalList('allowedDomains', 50) &&
        isValidOptionalBool('requireMfa') &&
        isValidOptionalNumber('sessionTimeoutMinutes', 5, 43200) &&
        (!('defaultAccessScope' in data) || data.defaultAccessScope == null || (data.defaultAccessScope in ['all', 'assigned', 'team', 'own'])) &&
        (!('defaultRole' in data) || data.defaultRole == null || (data.defaultRole in ['INVESTMENT_LEAD', 'RESEARCH_ANALYST', 'REVIEWER', 'VIEWER'])) &&
        isValidOptionalBool('allowInternStartupCreation') &&
        isValidOptionalBool('requireTwoStepApproval') &&
        isValidOptionalMap('confidentialityDefaults', 30) &&
        isValidOptionalMap('notificationSettings', 30) &&
        isValidOptionalMap('branding', 30) &&
        isValidOptionalMap('integrations', 30) &&
        isValidOptionalMap('securityConfig', 30) &&
        isValidOptionalTimeField('createdAt');
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // 1. Users Collection — strict RBAC & anti-privilege-escalation
    match /users/{userId} {
      // Only the user themselves or SUPER_ADMIN / INVESTMENT_LEAD can read user profiles (prevents blanket PII exposure)
      allow read: if isOwner(userId) || isLeadOrAdmin();

      // Only SUPER_ADMIN (or server-side Admin SDK) can create user documents with roles/permissions
      allow create: if isSuperAdmin() &&
        isValidUser(request.resource.data);

      // SUPER_ADMIN can update user records; ordinary active users can only update their own non-privileged profile fields
      allow update: if isValidUser(request.resource.data) && (
        isSuperAdmin() ||
        (
          isOwner(userId) &&
          isActiveUser() &&
          uidNotModified() &&
          areImmutableFieldsUnchanged([
            'id', 'uid', 'email', 'role', 'permissions', 'status',
            'accessScope', 'assignedStartupIds', 'teamId', 'teamIds',
            'passwordHash', 'createdAt', 'createdBy', 'invitedBy'
          ])
        )
      );

      // Only SUPER_ADMIN can delete user records (and cannot self-delete)
      allow delete: if isSuperAdmin() && request.auth.uid != userId;
    }

    // 2. Teams Collection
    match /teams/{teamId} {
      allow read: if isActiveUser();

      allow create: if isLeadOrAdmin() &&
        isValidTeam(request.resource.data);

      allow update: if isLeadOrAdmin() &&
        isValidTeam(request.resource.data) &&
        areImmutableFieldsUnchanged(['id', 'createdBy', 'createdAt']);

      allow delete: if isSuperAdmin();
    }

    // 3. Invitations Collection
    match /invitations/{invitationId} {
      allow read: if isLeadOrAdmin();

      // INVESTMENT_LEAD cannot invite SUPER_ADMIN users
      allow create: if isValidInvitation(request.resource.data) &&
        request.resource.data.invitedBy == request.auth.uid && (
          isSuperAdmin() ||
          (isInvestmentLead() && request.resource.data.role != 'SUPER_ADMIN')
        );

      allow update: if isValidInvitation(request.resource.data) &&
        areImmutableFieldsUnchanged(['id', 'email', 'invitedBy', 'createdAt']) && (
          isSuperAdmin() ||
          (
            isInvestmentLead() &&
            resource.data.role != 'SUPER_ADMIN' &&
            request.resource.data.role != 'SUPER_ADMIN'
          )
        );

      allow delete: if isSuperAdmin();
    }

    // 4. Startups Collection
    match /startups/{startupId} {
      allow read: if canReadStartupData(resource.data);

      // SUPER_ADMIN and INVESTMENT_LEAD can create startups from any source;
      // RESEARCH_ANALYST can create startups ONLY if source == 'Intern Research' and createdBy == request.auth.uid
      allow create: if isValidStartup(request.resource.data) &&
        request.resource.data.createdBy == request.auth.uid && (
          isLeadOrAdmin() ||
          (
            isResearchAnalyst() &&
            request.resource.data.source == 'Intern Research' &&
            !('latestDecision' in request.resource.data && request.resource.data.latestDecision != null) &&
            !('decision' in request.resource.data && request.resource.data.decision != null) &&
            !('investmentDecision' in request.resource.data && request.resource.data.investmentDecision != null) &&
            !('approvedBy' in request.resource.data && request.resource.data.approvedBy != null)
          )
        );

      // SUPER_ADMIN and INVESTMENT_LEAD can update all startup fields;
      // RESEARCH_ANALYST can update startups they are assigned to (non-decision / non-permission fields only)
      allow update: if isValidStartup(request.resource.data) &&
        areImmutableFieldsUnchanged(['id', 'startupCode', 'createdBy', 'createdAt']) && (
          isLeadOrAdmin() ||
          (
            isResearchAnalyst() &&
            isAssignedToStartupData(resource.data) &&
            areImmutableFieldsUnchanged([
              'source', 'assignedUsers', 'assignedUserIds', 'assignedLeadId',
              'leadOwnerId', 'assignedResearcherId', 'reviewerId', 'collaboratorIds',
              'teamId', 'latestDecision', 'decisionHistory', 'decision',
              'decisionStatus', 'investmentDecision', 'icDecision',
              'approvedBy', 'approvedAt', 'confidentiality', 'archived', 'isArchived'
            ])
          )
        );

      // RESEARCH_ANALYST, REVIEWER, VIEWER cannot delete startups
      allow delete: if isSuperAdmin();
    }

    // 5. Submissions Collection
    // Public pitch submissions are created exclusively by the server-side /api/pitch Admin SDK endpoint.
    match /submissions/{submissionId} {
      allow read: if isLeadOrAdmin() || (
        isActiveUser() && (
          hasAllAccessScope() ||
          hasPermission('submission.view') ||
          ('assignedUsers' in resource.data && resource.data.assignedUsers is list && request.auth.uid in resource.data.assignedUsers) ||
          ('startupId' in resource.data && resource.data.startupId is string && canAccessStartupId(resource.data.startupId))
        )
      );

      allow create: if isLeadOrAdmin() &&
        isValidSubmission(request.resource.data);

      allow update: if isLeadOrAdmin() &&
        isValidSubmission(request.resource.data) &&
        areImmutableFieldsUnchanged(['id', 'referenceId', 'founderEmail', 'submittedAt', 'createdAt']);

      allow delete: if isSuperAdmin();
    }

    // 6. Assignments Collection
    match /assignments/{assignmentId} {
      allow read: if isLeadOrAdmin() || (
        isActiveUser() && (
          ('assigneeId' in resource.data && resource.data.assigneeId == request.auth.uid) ||
          ('primaryResearcherId' in resource.data && resource.data.primaryResearcherId == request.auth.uid) ||
          ('reviewerId' in resource.data && resource.data.reviewerId == request.auth.uid) ||
          ('assignedUsers' in resource.data && resource.data.assignedUsers is list && request.auth.uid in resource.data.assignedUsers) ||
          hasAllAccessScope() ||
          canAccessStartupId(resource.data.startupId)
        )
      );

      allow create: if isLeadOrAdmin() &&
        isValidAssignment(request.resource.data);

      allow update: if isValidAssignment(request.resource.data) &&
        areImmutableFieldsUnchanged(['id', 'startupId', 'createdBy', 'assignedBy', 'createdAt']) && (
          isLeadOrAdmin() ||
          (
            isActiveUser() &&
            !isViewer() &&
            (
              ('assigneeId' in resource.data && resource.data.assigneeId == request.auth.uid) ||
              ('primaryResearcherId' in resource.data && resource.data.primaryResearcherId == request.auth.uid) ||
              ('reviewerId' in resource.data && resource.data.reviewerId == request.auth.uid) ||
              ('assignedUsers' in resource.data && resource.data.assignedUsers is list && request.auth.uid in resource.data.assignedUsers)
            ) &&
            areImmutableFieldsUnchanged(['primaryResearcherId', 'assigneeId', 'reviewerId', 'assignedUsers', 'priority', 'dueDate'])
          )
        );

      allow delete: if isLeadOrAdmin();
    }

    // 7. Research Collection
    match /research/{researchId} {
      allow read: if isLeadOrAdmin() || (
        isActiveUser() && (
          ('authorId' in resource.data && resource.data.authorId == request.auth.uid) ||
          ('primaryResearcherId' in resource.data && resource.data.primaryResearcherId == request.auth.uid) ||
          ('assignedUsers' in resource.data && resource.data.assignedUsers is list && request.auth.uid in resource.data.assignedUsers) ||
          canAccessStartupId(resource.data.startupId)
        )
      );

      // RESEARCH_ANALYST can create their own research drafts (cannot self-approve)
      allow create: if isValidResearch(request.resource.data) &&
        canAccessStartupId(request.resource.data.startupId) && (
          isLeadOrAdmin() ||
          (
            isResearchAnalyst() &&
            (
              ('primaryResearcherId' in request.resource.data && request.resource.data.primaryResearcherId == request.auth.uid) ||
              ('authorId' in request.resource.data && request.resource.data.authorId == request.auth.uid)
            ) &&
            (request.resource.data.status in ['draft', 'in_progress', 'submitted', 'in_review']) &&
            !('approvedBy' in request.resource.data && request.resource.data.approvedBy != null) &&
            !('approvedAt' in request.resource.data && request.resource.data.approvedAt != null)
          )
        );

      // Updates:
      // - SUPER_ADMIN / INVESTMENT_LEAD can update/approve any research record
      // - RESEARCH_ANALYST can update their own or collaborated non-approved research drafts (cannot set status == 'approved')
      // - REVIEWER can review, request revisions, or approve research on assigned startups (cannot self-approve own research)
      allow update: if isValidResearch(request.resource.data) &&
        areImmutableFieldsUnchanged(['id', 'startupId', 'primaryResearcherId', 'authorId', 'createdBy', 'createdAt']) && (
          isLeadOrAdmin() ||
          (
            isResearchAnalyst() &&
            (
              ('primaryResearcherId' in resource.data && resource.data.primaryResearcherId == request.auth.uid) ||
              ('authorId' in resource.data && resource.data.authorId == request.auth.uid) ||
              ('collaboratorIds' in resource.data && resource.data.collaboratorIds is list && request.auth.uid in resource.data.collaboratorIds)
            ) &&
            resource.data.status != 'approved' &&
            (request.resource.data.status in ['draft', 'in_progress', 'submitted', 'in_review']) &&
            areImmutableFieldsUnchanged(['approvedBy', 'approvedByName', 'approvedAt', 'reviewerId', 'reviewedAt', 'reviewNotes', 'confidentiality'])
          ) ||
          (
            isReviewer() &&
            (!('primaryResearcherId' in resource.data) || resource.data.primaryResearcherId != request.auth.uid) &&
            (!('authorId' in resource.data) || resource.data.authorId != request.auth.uid) &&
            canAccessStartupId(resource.data.startupId) &&
            (request.resource.data.status in ['in_review', 'revision_requested', 'changes_requested', 'approved', 'rejected']) &&
            areImmutableFieldsUnchanged(['templateId', 'confidentiality'])
          )
        );

      allow delete: if isSuperAdmin();
    }

    // 8. Research Sources Collection
    match /research_sources/{sourceId} {
      allow read: if isActiveUser() && (
        !('startupId' in resource.data) ||
        resource.data.startupId == null ||
        resource.data.startupId == "" ||
        canAccessStartupId(resource.data.startupId)
      );

      allow create: if isActiveUser() &&
        (isLeadOrAdmin() || isResearchAnalyst() || isReviewer()) &&
        isValidResearchSource(request.resource.data) &&
        request.resource.data.createdBy == request.auth.uid &&
        (!('startupId' in request.resource.data) || request.resource.data.startupId == null || request.resource.data.startupId == "" || canAccessStartupId(request.resource.data.startupId));

      allow update: if isActiveUser() &&
        isValidResearchSource(request.resource.data) &&
        areImmutableFieldsUnchanged(['id', 'startupId', 'createdBy', 'createdAt']) && (
          isLeadOrAdmin() ||
          (
            (isResearchAnalyst() || isReviewer()) &&
            resource.data.createdBy == request.auth.uid
          )
        );

      allow delete: if isLeadOrAdmin() || (
        isResearchAnalyst() &&
        resource.data.createdBy == request.auth.uid
      );
    }

    // 9. Competitors Collection
    match /competitors/{competitorId} {
      allow read: if isActiveUser() && canAccessStartupId(resource.data.startupId);

      allow create: if isActiveUser() &&
        (isLeadOrAdmin() || isResearchAnalyst() || isReviewer()) &&
        isValidCompetitor(request.resource.data) &&
        request.resource.data.createdBy == request.auth.uid &&
        canAccessStartupId(request.resource.data.startupId);

      allow update: if isActiveUser() &&
        isValidCompetitor(request.resource.data) &&
        areImmutableFieldsUnchanged(['id', 'startupId', 'createdBy', 'createdAt']) && (
          isLeadOrAdmin() ||
          (
            (isResearchAnalyst() || isReviewer()) &&
            resource.data.createdBy == request.auth.uid &&
            canAccessStartupId(resource.data.startupId)
          )
        );

      allow delete: if isLeadOrAdmin();
    }

    // 10. Scorecards Collection
    match /scorecards/{scorecardId} {
      allow read: if isActiveUser();

      allow create: if isLeadOrAdmin() &&
        isValidScorecard(request.resource.data);

      allow update: if isLeadOrAdmin() &&
        isValidScorecard(request.resource.data) &&
        areImmutableFieldsUnchanged(['id', 'createdBy', 'createdAt']);

      allow delete: if isSuperAdmin();
    }

    // 11. Evaluations Collection
    match /evaluations/{evaluationId} {
      allow read: if isLeadOrAdmin() || (
        isActiveUser() && (
          resource.data.evaluatorId == request.auth.uid ||
          canAccessStartupId(resource.data.startupId)
        )
      );

      allow create: if isActiveUser() &&
        (isLeadOrAdmin() || isReviewer()) &&
        isValidEvaluation(request.resource.data) &&
        request.resource.data.evaluatorId == request.auth.uid &&
        canAccessStartupId(request.resource.data.startupId);

      allow update: if isActiveUser() &&
        isValidEvaluation(request.resource.data) &&
        areImmutableFieldsUnchanged(['id', 'startupId', 'evaluatorId', 'createdAt']) && (
          isLeadOrAdmin() ||
          (
            isReviewer() &&
            resource.data.evaluatorId == request.auth.uid &&
            canAccessStartupId(resource.data.startupId)
          )
        );

      allow delete: if isSuperAdmin();
    }

    // 12. Decisions Collection (Investment Decisions — locked to SUPER_ADMIN & INVESTMENT_LEAD for writes)
    match /decisions/{decisionId} {
      allow read: if isLeadOrAdmin() || (
        isActiveUser() && canAccessStartupId(resource.data.startupId)
      );

      allow create: if isLeadOrAdmin() &&
        isValidDecision(request.resource.data) &&
        request.resource.data.decidedBy == request.auth.uid;

      allow update: if isLeadOrAdmin() &&
        isValidDecision(request.resource.data) &&
        areImmutableFieldsUnchanged(['id', 'startupId', 'decidedBy', 'decidedAt', 'createdAt']);

      allow delete: if isSuperAdmin();
    }

    // 13. Tasks Collection
    match /tasks/{taskId} {
      allow read: if isLeadOrAdmin() || (
        isActiveUser() && (
          ('assigneeId' in resource.data && resource.data.assigneeId == request.auth.uid) ||
          ('assignedToId' in resource.data && resource.data.assignedToId == request.auth.uid) ||
          ('assignedUsers' in resource.data && resource.data.assignedUsers is list && request.auth.uid in resource.data.assignedUsers) ||
          resource.data.createdBy == request.auth.uid ||
          hasAllAccessScope() ||
          ('startupId' in resource.data && resource.data.startupId is string && canAccessStartupId(resource.data.startupId))
        )
      );

      allow create: if isActiveUser() &&
        isValidTask(request.resource.data) &&
        request.resource.data.createdBy == request.auth.uid && (
          isLeadOrAdmin() ||
          (
            (isResearchAnalyst() || isReviewer()) &&
            (
              ('assigneeId' in request.resource.data && request.resource.data.assigneeId == request.auth.uid) ||
              ('assignedToId' in request.resource.data && request.resource.data.assignedToId == request.auth.uid)
            ) &&
            (!('startupId' in request.resource.data) || request.resource.data.startupId == null || request.resource.data.startupId == "" || canAccessStartupId(request.resource.data.startupId))
          )
        );

      allow update: if isActiveUser() &&
        isValidTask(request.resource.data) &&
        areImmutableFieldsUnchanged(['id', 'createdBy', 'createdAt']) && (
          isLeadOrAdmin() ||
          (
            (isResearchAnalyst() || isReviewer()) &&
            (
              ('assigneeId' in resource.data && resource.data.assigneeId == request.auth.uid) ||
              ('assignedToId' in resource.data && resource.data.assignedToId == request.auth.uid) ||
              ('assignedUsers' in resource.data && resource.data.assignedUsers is list && request.auth.uid in resource.data.assignedUsers) ||
              resource.data.createdBy == request.auth.uid
            ) &&
            areImmutableFieldsUnchanged(['startupId', 'assigneeId', 'assignedToId', 'priority'])
          )
        );

      allow delete: if isLeadOrAdmin();
    }

    // 14. Comments Collection
    match /comments/{commentId} {
      allow read: if isLeadOrAdmin() || (
        isActiveUser() && (
          hasAllAccessScope() ||
          resource.data.authorId == request.auth.uid ||
          ('startupId' in resource.data && resource.data.startupId is string && canAccessStartupId(resource.data.startupId))
        )
      );

      allow create: if isActiveUser() &&
        (isLeadOrAdmin() || isResearchAnalyst() || isReviewer()) &&
        isValidComment(request.resource.data) &&
        request.resource.data.authorId == request.auth.uid &&
        (!('startupId' in request.resource.data) || request.resource.data.startupId == null || request.resource.data.startupId == "" || canAccessStartupId(request.resource.data.startupId));

      allow update: if isActiveUser() &&
        isValidComment(request.resource.data) &&
        areImmutableFieldsUnchanged(['id', 'startupId', 'targetType', 'targetId', 'parentId', 'authorId', 'createdAt']) && (
          isLeadOrAdmin() ||
          (
            (isResearchAnalyst() || isReviewer()) &&
            resource.data.authorId == request.auth.uid
          )
        );

      allow delete: if isSuperAdmin() || (
        isActiveUser() &&
        !isViewer() &&
        resource.data.authorId == request.auth.uid
      );
    }

    // 15. Notifications Collection
    // VIEWER can mark their own notifications as read; no other writes allowed for VIEWER.
    match /notifications/{notificationId} {
      allow read: if isActiveUser() && (
        resource.data.recipientId == request.auth.uid ||
        isSuperAdmin()
      );

      allow create: if isActiveUser() &&
        !isViewer() &&
        isValidNotification(request.resource.data) &&
        (
          (!('senderId' in request.resource.data) || request.resource.data.senderId == null || request.resource.data.senderId == request.auth.uid) &&
          (!('actorId' in request.resource.data) || request.resource.data.actorId == null || request.resource.data.actorId == request.auth.uid)
        );

      allow update: if isActiveUser() &&
        isValidNotification(request.resource.data) &&
        areImmutableFieldsUnchanged(['id', 'recipientId', 'actorId', 'senderId', 'type', 'title', 'message', 'link', 'startupId', 'entityId', 'targetType', 'targetId', 'priority', 'createdAt']) && (
          isSuperAdmin() ||
          (
            resource.data.recipientId == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt', 'archived', 'updatedAt'])
          )
        );

      allow delete: if isSuperAdmin();
    }

    // 16. Documents Collection (Enforces confidentiality & allowedUserIds restrictions)
    match /documents/{documentId} {
      allow read: if canReadDocumentData(resource.data);

      allow create: if isActiveUser() &&
        (isLeadOrAdmin() || isResearchAnalyst() || isReviewer()) &&
        isValidDocument(request.resource.data) &&
        request.resource.data.uploadedBy == request.auth.uid &&
        (!('startupId' in request.resource.data) || request.resource.data.startupId == null || request.resource.data.startupId == "" || canAccessStartupId(request.resource.data.startupId)) &&
        (isLeadOrAdmin() || !(request.resource.data.confidentiality in ['confidential', 'restricted']));

      allow update: if isActiveUser() &&
        isValidDocument(request.resource.data) &&
        areImmutableFieldsUnchanged(['id', 'uploadedBy', 'createdAt']) && (
          isLeadOrAdmin() ||
          (
            (isResearchAnalyst() || isReviewer()) &&
            resource.data.uploadedBy == request.auth.uid &&
            !(resource.data.confidentiality in ['confidential', 'restricted']) &&
            areImmutableFieldsUnchanged(['confidentiality', 'allowedUserIds', 'allowedRoles', 'startupId'])
          )
        );

      allow delete: if isSuperAdmin() || (
        isInvestmentLead() &&
        !(resource.data.confidentiality in ['confidential', 'restricted'])
      );
    }

    // 17. Research Library Collection
    match /research_library/{libraryId} {
      allow read: if isActiveUser() && (
        isLeadOrAdmin() ||
        !('confidentiality' in resource.data) ||
        !(resource.data.confidentiality in ['confidential', 'restricted']) ||
        (!isViewer() && (
          resource.data.authorId == request.auth.uid ||
          ('allowedUserIds' in resource.data && resource.data.allowedUserIds is list && request.auth.uid in resource.data.allowedUserIds)
        ))
      );

      allow create: if isActiveUser() &&
        (isLeadOrAdmin() || isResearchAnalyst() || isReviewer()) &&
        isValidResearchLibraryItem(request.resource.data) &&
        request.resource.data.authorId == request.auth.uid &&
        (isLeadOrAdmin() || !('confidentiality' in request.resource.data) || !(request.resource.data.confidentiality in ['confidential', 'restricted']));

      allow update: if isActiveUser() &&
        isValidResearchLibraryItem(request.resource.data) &&
        areImmutableFieldsUnchanged(['id', 'authorId', 'createdAt']) && (
          isLeadOrAdmin() ||
          (
            (isResearchAnalyst() || isReviewer()) &&
            (
              resource.data.authorId == request.auth.uid ||
              ('contributorIds' in resource.data && resource.data.contributorIds is list && request.auth.uid in resource.data.contributorIds)
            ) &&
            areImmutableFieldsUnchanged(['confidentiality', 'allowedUserIds', 'isFeatured'])
          )
        );

      allow delete: if isLeadOrAdmin();
    }

    // 18. Pipeline Stages Collection
    match /pipeline_stages/{stageId} {
      allow read: if isActiveUser();

      allow create: if isLeadOrAdmin() &&
        isValidPipelineStage(request.resource.data);

      allow update: if isLeadOrAdmin() &&
        isValidPipelineStage(request.resource.data) &&
        areImmutableFieldsUnchanged(['id', 'createdAt']);

      allow delete: if isSuperAdmin();
    }

    // 19. Saved Views Collection
    match /saved_views/{viewId} {
      allow read: if isActiveUser() && (
        ('ownerId' in resource.data && resource.data.ownerId == request.auth.uid) ||
        ('userId' in resource.data && resource.data.userId == request.auth.uid) ||
        ('isSystem' in resource.data && resource.data.isSystem == true) ||
        ('isShared' in resource.data && resource.data.isShared == true) ||
        isSuperAdmin()
      );

      allow create: if isActiveUser() &&
        !isViewer() &&
        isValidSavedView(request.resource.data) &&
        (
          ('ownerId' in request.resource.data && request.resource.data.ownerId == request.auth.uid) ||
          ('userId' in request.resource.data && request.resource.data.userId == request.auth.uid)
        ) &&
        (isLeadOrAdmin() || (
          (!('isShared' in request.resource.data) || request.resource.data.isShared == false) &&
          (!('isSystem' in request.resource.data) || request.resource.data.isSystem == false)
        ));

      allow update: if isActiveUser() &&
        !isViewer() &&
        isValidSavedView(request.resource.data) &&
        areImmutableFieldsUnchanged(['id', 'ownerId', 'userId', 'entityType', 'createdAt']) && (
          isSuperAdmin() ||
          (
            (
              ('ownerId' in resource.data && resource.data.ownerId == request.auth.uid) ||
              ('userId' in resource.data && resource.data.userId == request.auth.uid)
            ) &&
            (isLeadOrAdmin() || (
              (!('isShared' in request.resource.data) || request.resource.data.isShared == false) &&
              (!('isSystem' in request.resource.data) || request.resource.data.isSystem == false)
            ))
          )
        );

      allow delete: if isActiveUser() && (
        ('ownerId' in resource.data && resource.data.ownerId == request.auth.uid) ||
        ('userId' in resource.data && resource.data.userId == request.auth.uid) ||
        isSuperAdmin()
      );
    }

    // 20. Research Templates Collection
    match /research_templates/{templateId} {
      allow read: if isActiveUser();

      allow create: if isLeadOrAdmin() &&
        isValidResearchTemplate(request.resource.data) &&
        request.resource.data.updatedBy == request.auth.uid;

      allow update: if isLeadOrAdmin() &&
        isValidResearchTemplate(request.resource.data) &&
        areImmutableFieldsUnchanged(['id', 'createdBy', 'createdAt']) &&
        request.resource.data.updatedBy == request.auth.uid;

      allow delete: if isSuperAdmin();
    }

    // 21. Activity Logs Collection (Immutable / Append-Only)
    match /activity_logs/{logId} {
      allow read: if isActiveUser() && (
        isLeadOrAdmin() ||
        hasAllAccessScope() ||
        resource.data.actorId == request.auth.uid ||
        ('startupId' in resource.data && resource.data.startupId is string && canAccessStartupId(resource.data.startupId))
      );

      allow create: if isActiveUser() &&
        isValidActivityLog(request.resource.data) &&
        request.resource.data.actorId == request.auth.uid;

      allow update, delete: if false;
    }

    // 22. Audit Logs Collection (Immutable / Append-Only, Read by SUPER_ADMIN only)
    match /audit_logs/{auditId} {
      allow read: if isSuperAdmin();

      allow create: if isActiveUser() &&
        isValidAuditLog(request.resource.data) &&
        request.resource.data.actorId == request.auth.uid;

      allow update, delete: if false;
    }

    // 23. Workspace Settings Collection (Read by active users, Write by SUPER_ADMIN only)
    match /workspace_settings/{settingId} {
      allow read: if isActiveUser();

      allow create, update: if isSuperAdmin() &&
        isValidWorkspaceSetting(request.resource.data) &&
        request.resource.data.updatedBy == request.auth.uid;

      allow delete: if false;
    }

    // Default Deny — Deny all unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
